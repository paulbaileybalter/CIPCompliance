{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "balter-cip-tracker",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",

  // The whole site lives in ./public. The Worker runs first so every file sits behind the password.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },

  // No namespace id on purpose: Cloudflare creates this KV namespace for you on the first deploy
  // (automatic resource provisioning) and keeps using it afterwards.
  "kv_namespaces": [{ "binding": "KV" }],

  "observability": { "enabled": true }
}
